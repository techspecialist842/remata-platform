# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.

aws_region      = "us-east-2"
container_image = "" # <ecr_repo_url>:staging-<sha>, from ECR after a CI image push
alert_email     = "" # pending ops stakeholder
domain_name     = "" # optional, e.g. staging.remata.app -- leave empty for HTTP-only. DNS is Cloudflare, not Route53.
activate_https  = false # flip true only after the ACM cert shows ISSUED (add the CNAME from acm_validation_record at Cloudflare first)
