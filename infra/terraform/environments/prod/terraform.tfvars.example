aws_region      = "us-east-2"
container_image = "" # <ecr_repo_url>:prod-<sha>, from ECR after a CI image push
alert_email     = "" # required -- terraform plan fails without this on prod
domain_name     = "" # strongly recommended for prod, e.g. remata.app (apex). DNS is Cloudflare, not Route53.
activate_https  = false # flip true only after the ACM cert shows ISSUED (add the CNAME from acm_validation_record at Cloudflare first)
