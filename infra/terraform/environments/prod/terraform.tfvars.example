aws_region        = "us-east-2"
container_image   = "" # <ecr_repo_url>:prod-<sha>, from ECR after a CI image push
alert_email       = "" # required -- terraform plan fails without this on prod
domain_name       = "" # strongly recommended for prod, e.g. app.remata.com or remata.com
route53_zone_name = "" # required if domain_name is set, e.g. remata.com
