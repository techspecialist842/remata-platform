# Node / NestJS
node_modules/
dist/
coverage/
*.log
npm-debug.log*
.env
.env.*
!.env.example

# Terraform
**/.terraform/
# .terraform.lock.hcl is intentionally NOT ignored — commit it for
# reproducible provider version resolution across machines/CI.
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
**/terraform.tfvars
**/backend.hcl
# One-off operational scripts: these set AWS credentials as environment
# variables in plaintext, so they must never reach this repository (which is
# public). Keep the wildcard broad rather than naming individual scripts.
**/*.ps1

# Client business documents — confidential, and this repository is public.
# They are kept locally and shared with the client directly, never committed.
# (See the client instruction on remata-docs: nothing is uploaded without
# explicit approval.)
*.docx
*.pdf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
