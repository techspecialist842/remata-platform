PORT=3000
DATABASE_URL=postgresql://remata:remata@localhost:5432/remata
DB_SSL=false
DB_LOGGING=false

# Generate distinct random values per environment — never reuse across dev/staging/prod.
JWT_ACCESS_SECRET=change-me
JWT_ENROLLMENT_SECRET=change-me-too

# fail-open (allow through on scoring failure) or fail-closed (deny on scoring failure)
FRAUD_POLICY=fail-open

# Only used by `npm run seed:admin`, for the one-time first-admin bootstrap.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
